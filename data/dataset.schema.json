{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usccolumbia/matverse/blob/main/data/dataset.schema.json",
  "title": "MatVerse dataset catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "description",
      "version",
      "year",
      "count",
      "count_display",
      "count_unit",
      "count_scope",
      "count_precision",
      "structure_level",
      "provenance",
      "properties",
      "access",
      "license",
      "links",
      "sources",
      "caveats",
      "tags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string"
      },
      "category": {
        "enum": [
          "aggregated_crystals",
          "bulk_computed",
          "experimental_crystallography",
          "mlip_configurations",
          "two_dimensional",
          "porous_frameworks",
          "molecular_crystals",
          "surfaces_catalysis",
          "property_benchmarks",
          "generation_benchmarks",
          "experimental_properties",
          "diffraction_spectroscopy"
        ]
      },
      "description": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "year": {
        "type": [
          "integer",
          "null"
        ]
      },
      "count": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "count_display": {
        "type": "string"
      },
      "count_unit": {
        "type": "string"
      },
      "count_scope": {
        "type": "string"
      },
      "count_precision": {
        "enum": [
          "exact",
          "approximate",
          "lower_bound",
          "unknown"
        ]
      },
      "structure_level": {
        "enum": [
          "periodic_atomic",
          "structure_linked",
          "composition_only",
          "mixed"
        ]
      },
      "provenance": {
        "type": "string"
      },
      "properties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "access": {
        "enum": [
          "open",
          "registration",
          "restricted",
          "commercial",
          "mixed"
        ]
      },
      "license": {
        "type": "string"
      },
      "links": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string",
          "format": "uri"
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "url",
            "title",
            "evidence",
            "verified_date"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "verified_date": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "caveats": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "additional_counts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "value",
            "unit",
            "scope"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      },
      "count_derivation": {
        "type": "object",
        "required": [
          "method",
          "values"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "count": {
              "type": "null"
            }
          }
        },
        "then": {
          "properties": {
            "count_precision": {
              "const": "unknown"
            }
          }
        },
        "else": {
          "properties": {
            "count_precision": {
              "enum": [
                "exact",
                "approximate",
                "lower_bound"
              ]
            }
          }
        }
      }
    ]
  }
}
