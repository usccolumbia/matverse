l theory calculations were used to compute the maximum value of the electron localization function, indicating that 42 are potential electrides. A model was then trained on this dataset and used to predict the electride behaviour of 14,437 hypothetical compounds generated by structural prototyping. Then, the stability and electride features of the 1254 electride candidates predicted by the model were carefully checked by high-throughput calculations.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://archive.materialscloud.org/doi/10.24435/materialscloud:zt-z4","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":1,"citationsOverTime":[{"year":"2026","total":1}],"partCount":0,"partOfCount":0,"versionCount":1,"versionOfCount":0,"created":"2025-06-24T11:06:28.000Z","registered":"2025-06-24T11:06:28.000Z","published":"2023","updated":"2026-11-02T13:31:38.000Z"},"relationships":{"client":{"data":{"id":"ethz.marvel","type":"clients"}},"provider":{"data":{"id":"hedk","type":"providers"}},"media":{"data":{"id":"10.24435/materialscloud:zt-z4","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.1021/jacs.3c10538","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[{"id":"10.24435/materialscloud:c8-gy","type":"dois"}]},"versionOf":{"data":[]}}}}