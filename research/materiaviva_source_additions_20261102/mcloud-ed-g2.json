ng"}],"publisher":"Materials Cloud","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"electronic structure"},{"lang":"en","subject":"OPTIMADE"},{"lang":"en","subject":"optical materials"},{"lang":"en","subject":"refractive index"},{"lang":"en","subject":"MODNet"}],"contributors":[{"name":"Evans, Matthew L.","nameType":"Personal","givenName":"Matthew L.","familyName":"Evans","affiliation":["UCLouvain, Institut de la Matiere Condensée et des Nanosciences (IMCN), Chemin des Étoiles 8, Louvain-la-Neuve 1348, Belgium","Matgenix SRL, 185 Rue Armand Bury, 6534 Gozée, Belgium"],"contributorType":"ContactPerson","nameIdentifiers":[{"nameIdentifier":"0000-0002-1182-9098","nameIdentifierScheme":"ORCID"}]},{"name":"Rignanese, Gian-Marco","nameType":"Personal","givenName":"Gian-Marco","familyName":"Rignanese","affiliation":["UCLouvain, Institut de la Matiere Condensée et des Nanosciences (IMCN), Chemin des Étoiles 8, Louvain-la-Neuve 1348, Belgium"],"contributorType":"ContactPerson","nameIdentifiers":[{"nameIdentifier":"0000-0002-1422-1205","nameIdentifierScheme":"ORCID"}]}],"dates":[{"date":"2026-03-12","dateType":"Issued"}],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"relationType":"IsSupplementTo","relatedIdentifier":"10.5281/zenodo.12545611","resourceTypeGeneral":"Software","relatedIdentifierType":"DOI"},{"relationType":"IsSupplementTo","relatedIdentifier":"https://github.com/modl-uclouvain/re2fractive","resourceTypeGeneral":"Software","relatedIdentifierType":"URL"},{"relationType":"IsSupplementTo","relatedIdentifier":"10.1039/D4FD00092G","resourceTypeGeneral":"JournalArticle","relatedIdentifierType":"DOI"},{"relationType":"IsSupplementTo","relatedIdentifier":"10.48550/arXiv.2405.11393","resourceTypeGeneral":"Preprint","relatedIdentifierType":"DOI"},{"relationType":"IsSupplementedBy","relatedIdentifier":"https://chemiscope.materialscloud.io/?load=https%3A%2F%2Farchive.materialscloud.org%2Fapi%2Frecords%2Frr3za-8c528%2Ffiles%2Fdataset_chemiscope.json.gz%2Fcontent%3Ffilename%3Ddataset_chemiscope.json.gz%26materials_cloud_doi%3D10.24435%2Fmaterialscloud%3Akg-ea","relatedIdentifierType":"URL"},{"relationType":"HasVersion","relatedIdentifier":"10.24435/materialscloud:kg-ea","relatedIdentifierType":"DOI"},{"relationType":"HasVersion","relatedIdentifier":"10.24435/materialscloud:5p-vq","relatedIdentifierType":"DOI"}],"relatedItems":[{"titles":[{"title":"dataset_chemiscope.json"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/rr3za-8c528/files/dataset_chemiscope.json.gz/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"README"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/rr3za-8c528/files/README.md/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"data.tar"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/rr3za-8c528/files/data.tar.gz/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"structures.tar"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/rr3za-8c528/files/structures.tar.gz/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"optimade"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/rr3za-8c528/files/optimade.yaml/content","relatedItemIdentifierType":"URL"}}],"sizes":["4831013"],"formats":["application/gzip","text/markdown","application/gzip","application/gzip","application/octet-stream"],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"lang":"en","description":"Combinatorial and guided screening of materials space with density-functional theory and related approaches has provided a wealth of hypothetical inorganic materials, which are increasingly tabulated in open databases. The OPTIMADE API is a standardised format for representing crystal structures, their measured and computed properties, and the methods for querying and filtering them from remote resources. Currently, the OPTIMADE federation spans over 20 data providers, rendering over 30 million structures accessible in this way, many of which are novel and have only recently been suggested by machine learning-based approaches. In this work, we outline our approach to non-exhaustively screen this dynamic trove of structures for the next-generation of optical materials. By applying MODNet, a neural network-based model for property prediction that has been shown to perform especially well for small materials datasets, within a combined active learning and high-throughput computation framework, we isolate particular structures and chemistries that should be most fruitful for further theoretical calculations and for experimental study as high-refractive-index materials. By making explicit use of automated calculations, federated dataset curation and machine learning, and by releasing these publicly, the workflows presented here can be periodically re-assessed as new databases implement OPTIMADE, and new hypothetical materials are suggested.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://archive.materialscloud.org/doi/10.24435/materialscloud:ed-g2","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","sour