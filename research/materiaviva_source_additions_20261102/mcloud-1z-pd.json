Software","relatedIdentifierType":"URL"},{"relationType":"IsSupplementedBy","relatedIdentifier":"https://optimade.materialscloud.org/archive/wk-qm","relatedIdentifierType":"URL"},{"relationType":"IsSupplementedBy","relatedIdentifier":"https://chemiscope.materialscloud.io/?load=https%3A%2F%2Farchive.materialscloud.org%2Fapi%2Frecords%2Fzn7cy-7cs67%2Ffiles%2Fdataset_chemiscope.json.gz%2Fcontent%3Ffilename%3Ddataset_chemiscope.json.gz%26materials_cloud_doi%3D10.24435%2Fmaterialscloud%3Awk-qm","relatedIdentifierType":"URL"},{"relationType":"HasVersion","relatedIdentifier":"10.24435/materialscloud:wk-qm","relatedIdentifierType":"DOI"}],"relatedItems":[{"titles":[{"title":"optimade"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/zn7cy-7cs67/files/optimade.yaml/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"structures.tar"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/zn7cy-7cs67/files/structures.tar.gz/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"data.tar"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/zn7cy-7cs67/files/data.tar.gz/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"dataset_chemiscope.json"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/zn7cy-7cs67/files/dataset_chemiscope.json.gz/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"README"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/zn7cy-7cs67/files/README.md/content","relatedItemIdentifierType":"URL"}},{"titles":[{"title":"files_description"}],"relationType":"References","relatedItemType":"Other","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.materialscloud.org/api/records/zn7cy-7cs67/files/files_description.md/content","relatedItemIdentifierType":"URL"}}],"sizes":["5155554"],"formats":["application/octet-stream","application/gzip","application/gzip","application/gzip","text/markdown","text/markdown"],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"lang":"en","description":"Due to their abundant use in all-solid-state lasers, nonlinear optical (NLO) crystals are needed for many applications across diverse fields such as medicine and communication. However, because of conflicting requirements, the design of suitable inorganic crystals with strong second-harmonic generation (SHG) has proven to be challenging to both experimentalists and computational scientists. In this work, we leverage a data-driven approach to accelerate the search for high-performance NLO materials. We construct an extensive pool of candidates using databases within the OPTIMADE federation and employ an active learning strategy to gather optimal data while iteratively improving a machine learning model. The result is a publicly accessible dataset of ∼2,200 computed SHG tensors using density-functional perturbation theory. We further assess the performance of machine learning models on SHG prediction and introduce a multi-fidelity correction-learning scheme to refine data accuracy. This study represents a significant step towards data-driven materials discovery in the NLO field and demonstrates how new materials can be screened in an automated fashion.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://archive.materialscloud.org/doi/10.24435/materialscloud:1z-pd","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":2,"citationsOverTime":[{"year":"2026","total":3}],"partCount":0,"partOfCount":0,"versionCount":1,"versionOfCount":0,"created":"2025-07-28T10:26:14.000Z","registered":"2025-07-28T10:26:15.000Z","published":"2025","updated":"2026-11-02T13:26:08.000Z"},"relationships":{"client":{"data":{"id":"ethz.marvel","type":"clients"}},"provider":{"data":{"id":"hedk","type":"providers"}},"media":{"data":{"id":"10.24435/materialscloud:1z-pd","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.1039/d5tc01335f","type":"dois"},{"id":"10.48550/arxiv.2504.01526","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[{"id":"10.24435/materialscloud:wk-qm","type":"dois"}]},"versionOf":{"data":[]}}}}