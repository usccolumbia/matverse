erson", "title": {"de": "Kontaktperson", "en": "Contact person"}}, "affiliations": [{"name": "UCLouvain, Institut de la Matiere Condens\u00e9e et des Nanosciences (IMCN), Chemin des \u00c9toiles 8, Louvain-la-Neuve 1348, Belgium"}]}], "languages": [{"id": "eng", "title": {"en": "English"}}], "related_identifiers": [{"identifier": "https://topoclass.modl-uclouvain.org", "scheme": "url", "relation_type": {"id": "issupplementto", "title": {"en": "Is supplement to"}}, "resource_type": {"id": "other", "title": {"de": "Sonstige", "en": "Other"}}}, {"identifier": "10.1038/s41524-025-01687-2", "scheme": "doi", "relation_type": {"id": "issupplementto", "title": {"en": "Is supplement to"}}, "resource_type": {"id": "publication-article", "title": {"en": "Journal article"}}}, {"identifier": "https://chemiscope.materialscloud.io/?load=https%3A%2F%2F127.0.0.1%2Fapi%2Frecords%2Fgnv15-27a69%2Ffiles%2Ftopoclass.chemiscope.json.gz%2Fcontent%3Ffilename%3Dtopoclass.chemiscope.json.gz%26materials_cloud_doi%3D10.24435%2Fmaterialscloud%3Azk-gc", "scheme": "url", "relation_type": {"id": "issupplementedby", "title": {"en": "Is supplemented by"}}}, {"identifier": "https://optimade.materialscloud.org/archive/zk-gc", "scheme": "url", "relation_type": {"id": "issupplementedby", "title": {"en": "Is supplemented by"}}}], "sizes": ["668162274"], "formats": ["application/octet-stream", "application/gzip", "application/gzip", "application/octet-stream", "application/octet-stream", "text/markdown"], "rights": [{"id": "cc-by-4.0", "title": {"en": "Creative Commons Attribution 4.0 International"}, "description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "props": {"url": "https://creativecommons.org/licenses/by/4.0/legalcode", "scheme": "spdx"}}], "description": "A dataset of 35,608 materials with their topological properties is constructed by combining the density functional theory (DFT) results of Materiae and the Topological Materials Database. Thanks to this, machine-learning approaches are developed to categorize materials into five distinct topological types, with the XGBoost model achieving an impressive 85.2% classification accuracy. By conducting generalization tests on different sub-datasets, differences are identified between the original datasets in terms of topological types, chemical elements, unknown magnetic compounds, and feature space coverage. Their impact on model performance is analyzed.\nTurning to the simpler binary classification between trivial insulators and nontrivial topological materials, three different approaches are also tested. Key characteristics influencing material topology are identified, with the maximum packing efficiency and the fraction of p valence electrons being highlighted as critical features."}, "custom_fields": {"mc_references": [{"ref_resource_type": "website", "ref_citation": "Yuqing He et al., Machine learning on multiple topological materials datasets", "ref_link": {"ref_scheme": "url", "ref_identifier": "https://topoclass.modl-uclouvain.org"}}, {"ref_resource_type": "publication-article", "ref_citation": "Yuqing He at al., npj Computational Materials XX, XX (2025)", "ref_link": {"ref_scheme": "doi", "ref_identifier": "10.1038/s41524-025-01687-2"}, "ref_comment": "Paper describing the work performed"}]}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 6, "total_bytes": 668162274, "entries": {"topoclass.ipynb": {"id": "07570c31-c1f0-409f-b34f-444b916d697a", "checksum": "md5:e97367839d6f923849f6ab81ff7830f8", "ext": "bin", "size": 49935, "mimetype": "application/octet-stream", "storage_class": "L", "key": "topoclass.ipynb", "metadata": {}, "access": {"hidden": false}, "links": {"self": "https://archive.materialscloud.org/api/records/gnv15-27a69/files/topocla